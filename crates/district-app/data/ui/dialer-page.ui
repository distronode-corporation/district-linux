<?xml version="1.0" encoding="UTF-8"?>
<!-- The dialler: the country button and its searchable list, the box the
     number is typed or pasted into, the line naming where it rings, a keypad,
     and Call. src/pages/dialer.rs fills it, adds the keypad's keys and the
     list's rows. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDialerPage" parent="AdwBin">
    <property name="child">
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwClamp">
            <property name="maximum-size">360</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkMenuButton" id="country_button">
                            <property name="always-show-arrow">True</property>
                            <property name="child">
                              <object class="GtkLabel" id="country_button_label">
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="numeric"/>
                                </style>
                              </object>
                            </property>
                            <property name="popover">
                              <object class="GtkPopover" id="country_popover">
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">6</property>
                                    <property name="width-request">300</property>
                                    <child>
                                      <object class="GtkSearchEntry" id="country_search"/>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow">
                                        <property name="hscrollbar-policy">never</property>
                                        <property name="min-content-height">320</property>
                                        <property name="propagate-natural-height">True</property>
                                        <property name="max-content-height">420</property>
                                        <property name="child">
                                          <object class="GtkListBox" id="country_list">
                                            <property name="selection-mode">none</property>
                                            <style>
                                              <class name="navigation-sidebar"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="number_entry">
                            <property name="hexpand">True</property>
                            <property name="input-purpose">phone</property>
                            <property name="placeholder-text" translatable="yes" context="dialer_page.type_paste_number">Type or paste a number</property>
                            <style>
                              <class name="numeric"/>
                              <class name="dial-entry"/>
                            </style>
                            <accessibility>
                              <property name="label" translatable="yes" context="dialer_page.number_call">Number to call</property>
                            </accessibility>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="dial_destination">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <property name="selectable">True</property>
                        <style>
                          <class name="numeric"/>
                          <class name="dial-destination"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="dial_hint">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="keypad">
                    <property name="halign">center</property>
                    <property name="row-spacing">12</property>
                    <property name="column-spacing">18</property>
                    <property name="row-homogeneous">True</property>
                    <property name="column-homogeneous">True</property>
                    <accessibility>
                      <property name="label" translatable="yes" context="dialer_page.keypad">Keypad</property>
                    </accessibility>
                    <child>
                      <object class="GtkButton" id="backspace_button">
                        <property name="icon-name">edit-clear-symbolic</property>
                        <property name="tooltip-text" translatable="yes" context="dialer_page.delete_last_digit">Delete the last digit</property>
                        <property name="focus-on-click">False</property>
                        <accessibility>
                          <property name="label" translatable="yes" context="dialer_page.delete_last_digit_a11y">Delete the last digit</property>
                        </accessibility>
                        <style>
                          <class name="circular"/>
                          <class name="flat"/>
                          <class name="keypad-key"/>
                        </style>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="call_button">
                    <property name="halign">center</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">call-start-symbolic</property>
                        <property name="label" translatable="yes" context="dialer_page.call">Call</property>
                      </object>
                    </property>
                    <style>
                      <class name="pill"/>
                      <class name="call-action"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel" id="microphone_note">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="dial_busy_note">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                          <class name="warning"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
