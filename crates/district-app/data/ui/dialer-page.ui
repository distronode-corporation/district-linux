<?xml version="1.0" encoding="UTF-8"?>
<!-- The dialler: the number as it reads, the box it is typed or pasted into,
     a keypad, and Call. src/pages/dialer.rs fills it and adds the keypad's
     keys. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDialerPage" parent="AdwBin">
    <property name="child">
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwClamp">
            <property name="maximum-size">360</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <property name="valign">center</property>
                <child>
                  <object class="GtkLabel" id="number_label">
                    <property name="wrap">True</property>
                    <property name="wrap-mode">char</property>
                    <property name="justify">center</property>
                    <property name="use-markup">False</property>
                    <property name="selectable">True</property>
                    <style>
                      <class name="title-1"/>
                      <class name="numeric"/>
                      <class name="dial-display"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkEntry" id="number_entry">
                        <property name="input-purpose">phone</property>
                        <property name="xalign">0.5</property>
                        <property name="placeholder-text">Type or paste a number</property>
                        <accessibility>
                          <property name="label">Number to call</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="dial_hint">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid" id="keypad">
                    <property name="halign">center</property>
                    <property name="row-spacing">12</property>
                    <property name="column-spacing">18</property>
                    <property name="row-homogeneous">True</property>
                    <property name="column-homogeneous">True</property>
                    <accessibility>
                      <property name="label">Keypad</property>
                    </accessibility>
                    <child>
                      <object class="GtkButton" id="backspace_button">
                        <property name="icon-name">edit-clear-symbolic</property>
                        <property name="tooltip-text">Delete the last digit</property>
                        <property name="focus-on-click">False</property>
                        <accessibility>
                          <property name="label">Delete the last digit</property>
                        </accessibility>
                        <style>
                          <class name="circular"/>
                          <class name="flat"/>
                          <class name="keypad-key"/>
                        </style>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">3</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="call_button">
                    <property name="halign">center</property>
                    <property name="child">
                      <object class="AdwButtonContent">
                        <property name="icon-name">call-start-symbolic</property>
                        <property name="label">Call</property>
                      </object>
                    </property>
                    <style>
                      <class name="pill"/>
                      <class name="call-action"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">4</property>
                    <child>
                      <object class="GtkLabel" id="microphone_note">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="dial_busy_note">
                        <property name="wrap">True</property>
                        <property name="justify">center</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="caption"/>
                          <class name="warning"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
