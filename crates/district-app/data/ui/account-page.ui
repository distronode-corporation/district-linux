<?xml version="1.0" encoding="UTF-8"?>
<!-- The account: this build and this computer, whether the app starts at
     login, whether it sends crash reports, whether calls ring here, the devices signed in, signing out, and
     where deleting the account starts. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictAccountPage" parent="AdwBin">
    <property name="child">
      <object class="AdwPreferencesPage">
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes" context="account_page.computer">This computer</property>
            <child>
              <object class="AdwActionRow" id="device_row">
                <property name="title" translatable="yes" context="account_page.device_name">Device name</property>
                <property name="use-markup">False</property>
                <property name="subtitle-selectable">True</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="version_row">
                <property name="title" translatable="yes" context="account_page.district_ai_linux">District AI for Linux</property>
                <property name="use-markup">False</property>
                <property name="subtitle-selectable">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="start_at_login_row">
                <property name="title" translatable="yes" context="account_page.start_at_login">Start at login</property>
                <property name="subtitle" translatable="yes" context="account_page.start_at_login_body">Open District AI in the background when you log in, so calls ring here before you open the window. Closing the window keeps it running; Quit stops it.</property>
                <property name="use-markup">False</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="crash_reports_row">
                <property name="title" translatable="yes" context="account_page.crash_reports">Send crash reports</property>
                <property name="subtitle" translatable="yes" context="account_page.crash_reports_body">If District AI crashes, send Distronode a report so we can fix the problem. Your computer's name and your user name are left out.</property>
                <property name="use-markup">False</property>
                <property name="visible">False</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup" id="calls_group">
            <property name="title" translatable="yes" context="common.calls">Calls</property>
            <property name="visible">False</property>
            <child>
              <object class="AdwSwitchRow" id="ring_here_row">
                <property name="use-markup">False</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="presence_note">
                <property name="xalign">0</property>
                <property name="wrap">True</property>
                <property name="use-markup">False</property>
                <property name="margin-top">8</property>
                <property name="visible">False</property>
                <style>
                  <class name="caption"/>
                  <class name="error"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes" context="account_page.account">Your account</property>
            <child>
              <object class="AdwActionRow" id="devices_row">
                <property name="title" translatable="yes" context="account_page.devices">Devices</property>
                <property name="use-markup">False</property>
                <property name="activatable">True</property>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="sign_out_row">
                <property name="title" translatable="yes" context="account_page.sign_out">Sign out</property>
                <property name="use-markup">False</property>
                <property name="activatable">True</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="delete_row">
                <property name="title" translatable="yes" context="account_page.delete_account">Delete your account</property>
                <property name="use-markup">False</property>
                <property name="activatable">True</property>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="icon-name">adw-external-link-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
