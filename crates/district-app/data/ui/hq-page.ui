<?xml version="1.0" encoding="UTF-8"?>
<!-- District HQ: the conversation, the card for a proposed change, and the
     line to ask on. src/pages/hq.rs fills it; an answer's Markdown is drawn
     by src/markdown.rs. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictHqPage" parent="AdwBin">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkStack" id="stack">
            <property name="vexpand">True</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwStatusPage" id="empty_status">
                    <property name="icon-name">chat-message-new-symbolic</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">transcript</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scroller">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">760</property>
                        <property name="child">
                          <object class="GtkBox" id="messages">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-top">18</property>
                            <property name="margin-bottom">18</property>
                            <accessibility>
                              <property name="label">Conversation with District HQ</property>
                            </accessibility>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwClamp">
            <property name="maximum-size">760</property>
            <property name="child">
              <object class="GtkBox" id="bottom">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">18</property>
                <child>
                  <object class="GtkBox" id="status_box">
                    <property name="spacing">10</property>
                    <property name="visible">False</property>
                    <child>
                      <object class="GtkSpinner" id="thinking_spinner"/>
                    </child>
                    <child>
                      <object class="GtkLabel" id="status_label">
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="retry_button">
                        <property name="label">Try again</property>
                        <property name="valign">center</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="card">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="visible">False</property>
                    <style>
                      <class name="card"/>
                      <class name="proposal-card"/>
                    </style>
                    <child>
                      <object class="GtkLabel" id="card_title">
                        <property name="xalign">0</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="card_summary">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="wrap-mode">word-char</property>
                        <property name="use-markup">False</property>
                        <property name="selectable">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="card_note">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="card_failure">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <style>
                          <class name="error"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">8</property>
                        <property name="margin-top">6</property>
                        <property name="halign">end</property>
                        <child>
                          <object class="GtkSpinner" id="card_spinner">
                            <property name="valign">center</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="dismiss_button">
                            <style>
                              <class name="pill"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="confirm_button">
                            <style>
                              <class name="pill"/>
                              <class name="suggested-action"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <child>
                      <object class="GtkEntry" id="prompt_entry">
                        <property name="hexpand">True</property>
                        <property name="placeholder-text">Ask District HQ</property>
                        <property name="input-hints">spellcheck|uppercase-sentences</property>
                        <accessibility>
                          <property name="label">Ask District HQ</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="ask_button">
                        <property name="label">Ask</property>
                        <style>
                          <class name="suggested-action"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Each question is answered by an AI model, which is billed. A change it proposes is made only when you confirm it.</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <style>
                      <class name="dim-label"/>
                      <class name="caption"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
