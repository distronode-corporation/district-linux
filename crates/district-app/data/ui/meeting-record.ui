<?xml version="1.0" encoding="UTF-8"?>
<!-- A meeting's record over the rooms lobby: when it was, its minutes, its
     action items and its transcript. Closing it asks the core, which drops the
     record and closes it. src/pages/meeting_record.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictMeetingRecord" parent="AdwDialog">
    <property name="content-width">560</property>
    <property name="content-height">640</property>
    <property name="title">Meeting</property>
    <property name="can-close">False</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkStack" id="stack">
            <child>
              <object class="GtkStackPage">
                <property name="name">loading</property>
                <property name="child">
                  <object class="GtkSpinner" id="spinner">
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="width-request">32</property>
                    <property name="height-request">32</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">status</property>
                <property name="child">
                  <object class="AdwStatusPage" id="status">
                    <property name="icon-name">camera-web-symbolic</property>
                    <property name="title">Could not load this meeting</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">record</property>
                <property name="child">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup" id="details_group"/>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Minutes</property>
                        <child>
                          <object class="GtkLabel" id="minutes">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="use-markup">False</property>
                            <property name="selectable">True</property>
                            <style>
                              <class name="card"/>
                              <class name="text-card"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="actions_group">
                        <property name="title">Action items</property>
                        <child>
                          <object class="GtkLabel" id="actions">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="use-markup">False</property>
                            <property name="selectable">True</property>
                            <style>
                              <class name="card"/>
                              <class name="text-card"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="transcript_group">
                        <property name="title">Transcript</property>
                        <child>
                          <object class="GtkLabel" id="transcript">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="wrap-mode">word-char</property>
                            <property name="use-markup">False</property>
                            <property name="selectable">True</property>
                            <style>
                              <class name="card"/>
                              <class name="text-card"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
