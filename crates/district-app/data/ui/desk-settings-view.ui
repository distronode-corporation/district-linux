<?xml version="1.0" encoding="UTF-8"?>
<!-- The help desk's settings, built only from the settings read, and its
     logo, picked in the desktop's file chooser. src/pages/desk_settings.rs
     fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDeskSettingsView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="icon-name">emblem-system-symbolic</property>
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="label">Try again</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">form</property>
            <property name="child">
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">640</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">24</property>
                        <property name="margin-start">18</property>
                        <property name="margin-end">18</property>
                        <property name="margin-top">18</property>
                        <property name="margin-bottom">24</property>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Help desk</property>
                            <property name="description">Leave the name blank to show customers the workspace's own name.</property>
                            <child>
                              <object class="AdwSwitchRow" id="enabled_row">
                                <property name="title">Take tickets</property>
                                <property name="subtitle">While the desk is off, no tickets are recorded.</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="notify_row">
                                <property name="title">Email customers your replies</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwEntryRow" id="brand_row">
                                <property name="title">Name customers see</property>
                                <property name="use-markup">False</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="save_failure">
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                                <property name="wrap">True</property>
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="error"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinner" id="save_spinner">
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="save_button">
                                <property name="label">Save</property>
                                <property name="halign">end</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Logo</property>
                            <property name="description">Shown to customers on the help desk's pages. A PNG, JPEG or WebP image; District AI checks its size and dimensions.</property>
                            <property name="header-suffix">
                              <object class="GtkSpinner" id="logo_spinner">
                                <property name="visible">False</property>
                              </object>
                            </property>
                            <child>
                              <object class="AdwActionRow" id="logo_row">
                                <property name="title">Logo</property>
                                <property name="use-markup">False</property>
                                <child type="suffix">
                                  <object class="GtkButton" id="remove_button">
                                    <property name="label">Remove</property>
                                    <property name="valign">center</property>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkButton" id="choose_button">
                                    <property name="label">Choose an image</property>
                                    <property name="valign">center</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="logo_note_box">
                            <property name="spacing">12</property>
                            <property name="visible">False</property>
                            <style>
                              <class name="card"/>
                              <class name="composer-failure"/>
                            </style>
                            <child>
                              <object class="GtkLabel" id="logo_note">
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                                <property name="wrap">True</property>
                                <property name="use-markup">False</property>
                                <property name="margin-start">12</property>
                                <property name="margin-top">10</property>
                                <property name="margin-bottom">10</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="logo_dismiss">
                                <property name="label">Dismiss</property>
                                <property name="valign">center</property>
                                <property name="margin-end">10</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
