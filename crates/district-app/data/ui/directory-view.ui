<?xml version="1.0" encoding="UTF-8"?>
<!-- The transfer directory: each stored entry edited one key at a time, the
     entry being added, and a save that asks what it will replace first.
     src/pages/directory.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDirectoryView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">form</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="entries_group">
                    <property name="title">Transfer targets</property>
                    <child>
                      <object class="AdwActionRow" id="empty_row">
                        <property name="use-markup">False</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="add_group">
                    <property name="title">Add someone</property>
                    <child>
                      <object class="AdwEntryRow" id="new_name_row">
                        <property name="title">Name</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="new_number_row">
                        <property name="title">Phone number</property>
                        <property name="use-markup">False</property>
                        <property name="input-purpose">phone</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">10</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="GtkLabel" id="add_rejected">
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <property name="wrap">True</property>
                            <property name="use-markup">False</property>
                            <style>
                              <class name="error"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="add_button">
                            <property name="label">Add to the list</property>
                            <property name="halign">end</property>
                            <property name="hexpand">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="DistrictSaveNotice" id="notice"/>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">10</property>
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkSpinner" id="spinner">
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="save_button">
                                <property name="label">Replace the directory</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
