<?xml version="1.0" encoding="UTF-8"?>
<!-- The booking pages' team section: the scheduler's users and teams.
     src/pages/scheduling_admin/team.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictSchedulingTeamPane" parent="AdwBin">
    <property name="child">
      <object class="AdwStatusPage" id="team_placeholder">
        <property name="icon-name">x-office-calendar-symbolic</property>
      </object>
    </property>
  </template>
</interface>
