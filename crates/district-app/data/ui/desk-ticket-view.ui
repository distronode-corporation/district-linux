<?xml version="1.0" encoding="UTF-8"?>
<!-- One help desk ticket: its customer, its status and the buttons that move
     it, its conversation, and the reply. src/pages/desk_ticket.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDeskTicketView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="icon-name">help-browser-symbolic</property>
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="label">Try again</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">ticket</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkScrolledWindow" id="scroller">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">760</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">14</property>
                            <property name="margin-start">18</property>
                            <property name="margin-end">18</property>
                            <property name="margin-top">18</property>
                            <property name="margin-bottom">12</property>
                            <child>
                              <object class="GtkLabel" id="reference">
                                <property name="xalign">0</property>
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="caption-heading"/>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="subject">
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="use-markup">False</property>
                                <property name="selectable">True</property>
                                <style>
                                  <class name="title-2"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="refresh_failure">
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="error"/>
                                  <class name="caption"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="linked"/>
                                    </style>
                                    <accessibility>
                                      <property name="label">Status</property>
                                    </accessibility>
                                    <child>
                                      <object class="GtkToggleButton" id="open_button">
                                        <property name="label">Open</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkToggleButton" id="waiting_button">
                                        <property name="label">Waiting</property>
                                        <property name="tooltip-text">Waiting on the customer</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkToggleButton" id="resolved_button">
                                        <property name="label">Resolved</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSpinner" id="status_spinner">
                                    <property name="visible">False</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel" id="status_failure">
                                <property name="xalign">0</property>
                                <property name="wrap">True</property>
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="error"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkLabel">
                                <property name="label">Conversation</property>
                                <property name="xalign">0</property>
                                <property name="margin-top">6</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox" id="messages">
                                <property name="orientation">vertical</property>
                                <property name="spacing">12</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="details_group">
                                <property name="title">Customer</property>
                                <property name="margin-top">12</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwClamp">
                    <property name="maximum-size">760</property>
                    <property name="child">
                      <object class="DistrictReplyBox" id="reply_box"/>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
