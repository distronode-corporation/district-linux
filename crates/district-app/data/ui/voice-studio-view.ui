<?xml version="1.0" encoding="UTF-8"?>
<!-- Voice Studio: the recipes, the signal chain with an editor per leg, the
     time-to-first-word meter and where the call is processed, in the service's
     own words, and the save. src/pages/voice_studio.rs fills it, and builds the
     rows that depend on the read. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictVoiceStudioView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">form</property>
            <property name="child">
              <object class="AdwPreferencesPage" id="page">
                <child>
                  <object class="AdwPreferencesGroup" id="heading_group">
                    <child>
                      <object class="AdwActionRow" id="tier_row">
                        <property name="use-markup">False</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="valign">center</property>
                            <style>
                              <class name="linked"/>
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="stable_button"/>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="latest_button">
                                <property name="group">stable_button</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="recipes_group">
                    <child>
                      <object class="AdwActionRow" id="based_row">
                        <property name="use-markup">False</property>
                        <child type="suffix">
                          <object class="GtkButton" id="reset_button">
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="chain_group"/>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="editor_group">
                    <child>
                      <object class="AdwComboRow" id="vendor_row">
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="model_row">
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="location_row">
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="voice_row">
                        <property name="use-markup">False</property>
                        <property name="enable-search">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwExpanderRow" id="advanced_row">
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="meter_group">
                    <child>
                      <object class="GtkLabel" id="meter_headline">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-bottom">6</property>
                        <style>
                          <class name="title-2"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="meter_note">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-bottom">6</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox" id="stages_list">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="meter_source">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-top">6</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="residency_group">
                    <child>
                      <object class="GtkLabel" id="residency_text">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="residency_legs">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-top">6</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="GtkLabel" id="notice">
                            <property name="xalign">0</property>
                            <property name="wrap">True</property>
                            <property name="use-markup">False</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">10</property>
                            <child>
                              <object class="GtkLabel" id="pending_label">
                                <property name="xalign">0</property>
                                <property name="hexpand">True</property>
                                <property name="use-markup">False</property>
                                <style>
                                  <class name="dim-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkSpinner" id="save_spinner">
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="save_button">
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
