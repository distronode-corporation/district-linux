<?xml version="1.0" encoding="UTF-8"?>
<!-- The receptionist's capabilities: a switch per tool, stored ids this build
     cannot name kept and shown, and the research switch, each saved apart.
     src/pages/tools.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictToolsView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">form</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="tools_group">
                    <property name="title">On a call</property>
                    <property name="description">What the receptionist may do. Saving replaces the stored list with these switches.</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="DistrictSaveNotice" id="tools_notice"/>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">10</property>
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkSpinner" id="tools_spinner">
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="save_tools_button">
                                <property name="label">Save capabilities</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="research_group">
                    <child>
                      <object class="AdwSwitchRow" id="research_row">
                        <property name="title">Research contacts</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <child>
                          <object class="DistrictSaveNotice" id="research_notice"/>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="spacing">10</property>
                            <property name="halign">end</property>
                            <child>
                              <object class="GtkSpinner" id="research_spinner">
                                <property name="visible">False</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="save_research_button">
                                <property name="label">Save research setting</property>
                                <style>
                                  <class name="pill"/>
                                  <class name="suggested-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
