<?xml version="1.0" encoding="UTF-8"?>
<!-- The installations signed in to the account, and signing them out. Each
     sign-out is asked about first, in a dialog src/pages/devices.rs opens. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictDevicesPage" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="icon-name">preferences-system-devices-symbolic</property>
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="label">Try again</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">list</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="notice_group">
                    <property name="visible">False</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">12</property>
                        <style>
                          <class name="card"/>
                        </style>
                        <child>
                          <object class="GtkLabel" id="notice_label">
                            <property name="xalign">0</property>
                            <property name="hexpand">True</property>
                            <property name="wrap">True</property>
                            <property name="margin-start">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="notice_dismiss">
                            <property name="label">Dismiss</property>
                            <property name="valign">center</property>
                            <property name="margin-end">12</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="devices_group">
                    <property name="title">Signed-in devices</property>
                    <property name="description">A device's last active time is when it last renewed its sign-in, which can trail real use by up to ten minutes.</property>
                    <property name="header-suffix">
                      <object class="GtkSpinner" id="busy_spinner">
                        <property name="visible">False</property>
                      </object>
                    </property>
                    <child>
                      <object class="GtkListBox" id="device_list">
                        <property name="selection-mode">none</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="GtkButton" id="everywhere_button">
                        <property name="label">Sign out of every device</property>
                        <property name="halign">center</property>
                        <style>
                          <class name="destructive-action"/>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
