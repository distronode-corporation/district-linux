<?xml version="1.0" encoding="UTF-8"?>
<!-- The booking pages' settings section: the member's profile and notifications, the booking pages' branding and the booking assistant.
     src/pages/scheduling_admin/settings.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictSchedulingSettingsPane" parent="AdwBin">
    <property name="child">
      <object class="AdwStatusPage" id="settings_placeholder">
        <property name="icon-name">x-office-calendar-symbolic</property>
      </object>
    </property>
  </template>
</interface>
