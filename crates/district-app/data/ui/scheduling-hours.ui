<?xml version="1.0" encoding="UTF-8"?>
<!-- The booking pages' working hours: the two editors' buttons, the week
     (every day, Monday first, an empty one too) and the dated overrides
     still to come. src/pages/scheduling_admin/hours.rs fills it, places the
     week's frame (loading, failed, ready) and builds the rows and the
     editors; every word is the core's. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictSchedulingHoursPane" parent="AdwBin">
    <property name="child">
      <object class="GtkScrolledWindow">
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="AdwClamp">
            <property name="maximum-size">640</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">24</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-top">24</property>
                <property name="margin-bottom">24</property>
                <child>
                  <object class="GtkBox" id="hours_write_bar">
                    <property name="spacing">6</property>
                    <property name="visible">False</property>
                    <child>
                      <object class="GtkButton" id="hours_week_button">
                        <style>
                          <class name="suggested-action"/>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="hours_overrides_button">
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="week_column">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="week_heading">
                        <property name="xalign">0</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="week_summary">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="visible">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="week_times_in">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <child>
                      <object class="GtkLabel" id="overrides_heading">
                        <property name="xalign">0</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="overrides_subtitle">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <style>
                          <class name="caption"/>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinner" id="overrides_spinner">
                        <property name="halign">start</property>
                        <property name="visible">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="overrides_failure">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="visible">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="overrides_empty">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="visible">False</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkListBox" id="overrides_list">
                        <property name="selection-mode">none</property>
                        <property name="visible">False</property>
                        <style>
                          <class name="boxed-list"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
