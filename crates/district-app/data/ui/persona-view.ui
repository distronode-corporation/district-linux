<?xml version="1.0" encoding="UTF-8"?>
<!-- The receptionist's persona: its texts from the settings read, its language
     and answer length only as the options offer them, a way to Voice Studio for
     the engine and the voice, the save, and the audition.
     src/pages/persona.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictPersonaView" parent="AdwBin">
    <property name="child">
      <object class="GtkStack" id="stack">
        <child>
          <object class="GtkStackPage">
            <property name="name">loading</property>
            <property name="child">
              <object class="GtkSpinner" id="loading_spinner">
                <property name="halign">center</property>
                <property name="valign">center</property>
                <property name="width-request">32</property>
                <property name="height-request">32</property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">status</property>
            <property name="child">
              <object class="AdwStatusPage" id="status">
                <property name="child">
                  <object class="GtkButton" id="retry_button">
                    <property name="halign">center</property>
                    <style>
                      <class name="pill"/>
                    </style>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="GtkStackPage">
            <property name="name">form</property>
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup" id="texts_group">
                    <property name="title" translatable="yes" context="persona_view.what_says">What it says</property>
                    <child>
                      <object class="AdwEntryRow" id="name_row">
                        <property name="title" translatable="yes" context="common.name">Name</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwEntryRow" id="greeting_row">
                        <property name="title" translatable="yes" context="persona_view.greeting">Greeting</property>
                        <property name="use-markup">False</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes" context="persona_view.personality">Personality</property>
                    <property name="description" translatable="yes" context="persona_view.how_behaves_written_into_every">How it behaves, written into every call's instructions.</property>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="min-content-height">110</property>
                        <style>
                          <class name="card"/>
                          <class name="composer-box"/>
                        </style>
                        <property name="child">
                          <object class="GtkTextView" id="personality_view">
                            <property name="wrap-mode">word-char</property>
                            <property name="accepts-tab">False</property>
                            <property name="top-margin">10</property>
                            <property name="bottom-margin">10</property>
                            <property name="left-margin">12</property>
                            <property name="right-margin">12</property>
                            <accessibility>
                              <property name="label" translatable="yes" context="persona_view.personality_a11y">Personality</property>
                            </accessibility>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="engine_group">
                    <property name="title" translatable="yes" context="persona_view.language_answers">Language and answers</property>
                    <property name="header-suffix">
                      <object class="GtkSpinner" id="options_spinner">
                        <property name="visible">False</property>
                      </object>
                    </property>
                    <child>
                      <object class="AdwActionRow" id="engine_row">
                        <property name="use-markup">False</property>
                        <property name="title" translatable="yes" context="persona_view.voice_engine">Voice engine</property>
                        <child type="suffix">
                          <object class="GtkButton" id="studio_button">
                            <property name="label" translatable="yes" context="persona_view.open_voice_studio">Open Voice Studio</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="language_row">
                        <property name="use-markup">False</property>
                        <property name="title" translatable="yes" context="persona_view.language">Language</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="length_row">
                        <property name="use-markup">False</property>
                        <property name="title" translatable="yes" context="persona_view.answer_length">Answer length</property>
                        <property name="use-subtitle">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="engine_note">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-top">6</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="options_retry">
                        <property name="label" translatable="yes" context="common.try_again">Try again</property>
                        <property name="halign">start</property>
                        <property name="margin-top">6</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="refit_note">
                        <property name="xalign">0</property>
                        <property name="wrap">True</property>
                        <property name="use-markup">False</property>
                        <property name="margin-top">6</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <child>
                          <object class="DistrictSaveNotice" id="notice"/>
                        </child>
                        <child>
                          <!-- Try and Save side by side, or one above the other when
                               the window is too narrow for both (French, Large Text). -->
                          <object class="GtkFlowBox">
                            <property name="selection-mode">none</property>
                            <property name="min-children-per-line">1</property>
                            <property name="max-children-per-line">2</property>
                            <property name="column-spacing">10</property>
                            <property name="row-spacing">10</property>
                            <child>
                              <object class="GtkFlowBoxChild">
                                <property name="focusable">False</property>
                                <property name="child">
                                  <object class="GtkButton" id="preview_button">
                                    <property name="halign">start</property>
                                    <property name="child">
                                      <object class="AdwButtonContent">
                                        <property name="icon-name">audio-speakers-symbolic</property>
                                        <property name="label" translatable="yes" context="persona_view.try_receptionist">Try this receptionist</property>
                                      </object>
                                    </property>
                                    <style>
                                      <class name="pill"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkFlowBoxChild">
                                <property name="focusable">False</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="spacing">10</property>
                                    <property name="halign">end</property>
                                    <child>
                                      <object class="GtkSpinner" id="save_spinner">
                                        <property name="visible">False</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="save_button">
                                        <property name="label" translatable="yes" context="common.save">Save</property>
                                        <style>
                                          <class name="pill"/>
                                          <class name="suggested-action"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
