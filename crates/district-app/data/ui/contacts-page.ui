<?xml version="1.0" encoding="UTF-8"?>
<!-- Contacts: the list beside the open contact or the blocked callers,
     folding to one pane at a time when narrow. src/pages/contacts.rs fills it,
     and opens the form that adds a contact as a dialog. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictContactsPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin">
        <property name="width-request">300</property>
        <property name="height-request">300</property>
        <child>
          <object class="AdwBreakpoint">
            <condition>max-width: 720sp</condition>
            <setter object="split_view" property="collapsed">True</setter>
          </object>
        </child>
        <property name="child">
          <object class="AdwNavigationSplitView" id="split_view">
            <property name="min-sidebar-width">260</property>
            <property name="max-sidebar-width">380</property>
            <property name="sidebar-width-fraction">0.4</property>
            <property name="sidebar">
              <object class="AdwNavigationPage">
                <property name="title">Contacts</property>
                <property name="tag">list</property>
                <property name="child">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">6</property>
                        <child>
                          <object class="GtkButton" id="add_button">
                            <property name="hexpand">True</property>
                            <property name="child">
                              <object class="AdwButtonContent">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="label">Add contact</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="blocked_button">
                            <property name="hexpand">True</property>
                            <property name="child">
                              <object class="AdwButtonContent">
                                <property name="icon-name">action-unavailable-symbolic</property>
                                <property name="label">Blocked callers</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStack" id="list_stack">
                        <property name="vexpand">True</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">loading</property>
                            <property name="child">
                              <object class="GtkSpinner" id="list_spinner">
                                <property name="halign">center</property>
                                <property name="valign">center</property>
                                <property name="width-request">32</property>
                                <property name="height-request">32</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">status</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="list_status">
                                <property name="icon-name">x-office-address-book-symbolic</property>
                                <style>
                                  <class name="compact"/>
                                </style>
                                <property name="child">
                                  <object class="GtkButton" id="list_retry">
                                    <property name="label">Try again</property>
                                    <property name="halign">center</property>
                                    <style>
                                      <class name="pill"/>
                                    </style>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">list</property>
                            <property name="child">
                              <object class="GtkScrolledWindow" id="list_scroller">
                                <property name="hscrollbar-policy">never</property>
                                <property name="child">
                                  <object class="GtkBox">
                                    <property name="orientation">vertical</property>
                                    <property name="spacing">8</property>
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">12</property>
                                    <child>
                                      <object class="GtkLabel" id="count_label">
                                        <property name="xalign">0</property>
                                        <style>
                                          <class name="dim-label"/>
                                          <class name="caption"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="refresh_failure">
                                        <property name="visible">False</property>
                                        <property name="xalign">0</property>
                                        <property name="wrap">True</property>
                                        <property name="use-markup">False</property>
                                        <style>
                                          <class name="error"/>
                                          <class name="caption"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkListBox" id="contact_list">
                                        <property name="selection-mode">single</property>
                                        <accessibility>
                                          <property name="label">Contacts</property>
                                        </accessibility>
                                        <style>
                                          <class name="boxed-list"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">6</property>
                                        <property name="halign">center</property>
                                        <child>
                                          <object class="GtkSpinner" id="more_spinner">
                                            <property name="visible">False</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="more_failure">
                                            <property name="visible">False</property>
                                            <property name="wrap">True</property>
                                            <property name="justify">center</property>
                                            <property name="use-markup">False</property>
                                            <style>
                                              <class name="error"/>
                                              <class name="caption"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="more_button">
                                            <property name="label">Try again</property>
                                            <property name="visible">False</property>
                                            <style>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
            <property name="content">
              <object class="AdwNavigationPage">
                <property name="title">Contact</property>
                <property name="tag">contact</property>
                <property name="child">
                  <object class="GtkStack" id="detail_stack">
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">none</property>
                        <property name="child">
                          <object class="AdwStatusPage">
                            <property name="icon-name">x-office-address-book-symbolic</property>
                            <property name="title">No contact open</property>
                            <property name="description">Choose a contact to see their details.</property>
                            <style>
                              <class name="compact"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">contact</property>
                        <property name="child">
                          <object class="DistrictContactView" id="contact_view"/>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">blocked</property>
                        <property name="child">
                          <object class="DistrictBlockedView" id="blocked_view"/>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
