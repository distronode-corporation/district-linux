<?xml version="1.0" encoding="UTF-8"?>
<!-- The form that raises a help desk ticket for a customer, or a support
     request with Distronode, as a dialog. Closing it asks the core, which
     keeps it open while the form is on its way. src/pages/ticket_form.rs
     fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictTicketForm" parent="AdwDialog">
    <property name="content-width">480</property>
    <property name="can-close">False</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-start-title-buttons">False</property>
            <property name="show-end-title-buttons">False</property>
            <child type="start">
              <object class="GtkButton" id="cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="submit_button">
                <style>
                  <class name="suggested-action"/>
                </style>
              </object>
            </child>
            <child type="end">
              <object class="GtkSpinner" id="spinner">
                <property name="visible">False</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup" id="main_group">
                <child>
                  <object class="AdwComboRow" id="kind_row">
                    <property name="title">What is it about</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="subject_row">
                    <property name="title">Subject</property>
                    <property name="use-markup">False</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="message_group">
                <property name="title">Message</property>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <property name="min-content-height">120</property>
                    <style>
                      <class name="card"/>
                      <class name="composer-box"/>
                    </style>
                    <property name="child">
                      <object class="GtkTextView" id="message">
                        <property name="wrap-mode">word-char</property>
                        <property name="accepts-tab">False</property>
                        <property name="top-margin">10</property>
                        <property name="bottom-margin">10</property>
                        <property name="left-margin">12</property>
                        <property name="right-margin">12</property>
                        <accessibility>
                          <property name="label">Message</property>
                        </accessibility>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup" id="customer_group">
                <property name="title">The customer</property>
                <property name="description">Optional. Replies are emailed to the address given here, when the desk emails customers.</property>
                <child>
                  <object class="AdwEntryRow" id="name_row">
                    <property name="title">Name</property>
                    <property name="use-markup">False</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="email_row">
                    <property name="title">Email address</property>
                    <property name="use-markup">False</property>
                    <property name="input-purpose">email</property>
                  </object>
                </child>
                <child>
                  <object class="AdwEntryRow" id="phone_row">
                    <property name="title">Phone number</property>
                    <property name="use-markup">False</property>
                    <property name="input-purpose">phone</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="GtkLabel" id="failure_label">
                    <property name="visible">False</property>
                    <property name="xalign">0</property>
                    <property name="wrap">True</property>
                    <property name="use-markup">False</property>
                    <style>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
