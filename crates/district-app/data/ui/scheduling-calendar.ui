<?xml version="1.0" encoding="UTF-8"?>
<!-- The booking pages' calendar section: the member's own calendars.
     src/pages/scheduling_admin/calendar.rs fills it. -->
<interface>
  <requires lib="gtk" version="4.14"/>
  <requires lib="Adw" version="1.5"/>
  <template class="DistrictSchedulingCalendarPane" parent="AdwBin">
    <property name="child">
      <object class="AdwStatusPage" id="calendar_placeholder">
        <property name="icon-name">x-office-calendar-symbolic</property>
      </object>
    </property>
  </template>
</interface>
