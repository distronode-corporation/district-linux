          <li>@metainfo.release_3_1_0.li1@</li>
          <li>@metainfo.release_3_1_0.li2@</li>
          <li>@metainfo.release_3_1_0.li3@</li>
          <li>@metainfo.release_3_1_0.li4@</li>
          <li>@metainfo.release_3_1_0.li5@</li>
          <li>@metainfo.release_3_1_0.li6@</li>
