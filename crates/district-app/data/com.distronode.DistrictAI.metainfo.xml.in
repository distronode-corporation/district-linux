        <ul>
          <li>@metainfo.release_3_0_2.li1@</li>
          <li>@metainfo.release_3_0_2.li2@</li>
          <li>@metainfo.release_3_0_2.li3@</li>
          <li>@metainfo.release_3_0_2.li4@</li>
